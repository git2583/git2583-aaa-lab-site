---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// 콘텐츠 컬렉션에서 안전하게 데이터를 가져옵니다.
const analysisEntries = await getCollection('90_analysis');
const proposalEntries = await getCollection('91_proposals');
---

<Layout title='AAA Lab 지식 베이스'>
    <h1>AAA Lab 지식 베이스</h1>
    <p>LLM 기반 지능형 지식 관리 및 협업 시스템 대시보드입니다.</p>

    <hr />

    <h2>분석 리포트 및 프로필</h2>
    <ul>
        {analysisEntries.map((entry) => (
            <li>
                <a href={`/analysis/${entry.slug}`}>{entry.data.title || entry.slug}</a>
            </li>
        ))}
    </ul>

    <h2>스킬 제안 및 인사이트</h2>
    <ul>
        {proposalEntries.map((entry) => (
            <li>
                <a href={`/proposals/${entry.slug}`}>{entry.data.title || entry.slug}</a>
            </li>
        ))}
    </ul>

    <hr />

    <p><a href="/skill-insight">기술 인사이트 목록 보기</a></p>
</Layout>