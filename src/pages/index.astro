---
import Layout from '../layouts/Layout.astro';

// 90_analysis와 91_proposals 폴더 안의 모든 마크다운 파일을 찾아옵니다.
const analysisFiles = await Astro.glob('./90_analysis/**/*.md');
const proposalFiles = await Astro.glob('./91_proposals/**/*.md');
---

<Layout title='AAA Lab 지식 베이스'>
    <h1>AAA Lab 지식 베이스</h1>
    <p>LLM 기반 지능형 지식 관리 및 협업 시스템 대시보드입니다.</p>

    <hr />

    <h2>📊 분석 리포트 및 프로필</h2>
    <ul>
        {analysisFiles.map((file) => (
            <li>
                <a href={file.url}>{file.url.split('/').pop()}</a>
            </li>
        ))}
    </ul>

    <h2>💡 스킬 제안 및 인사이트</h2>
    <ul>
        {proposalFiles.map((file) => (
            <li>
                <a href={file.url}>{file.url.split('/').pop()}</a>
            </li>
        ))}
    </ul>
</Layout>